# Copy this file to .env and fill in real values.
# .env is ignored by Git. NEVER commit real keys.

ENVIRONMENT=development

# Google Gemini (free tier) via its OpenAI-compatible endpoint
LLM_API_KEY=your-gemini-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=your-gemini-model-id-here
# Seconds to wait for one LLM answer before giving up (SDK retries up to 2 more times)
LLM_TIMEOUT_SECONDS=30

# Embeddings: text -> vector of numbers. Optional (these are the defaults).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Supabase (Project Settings → API Keys). BACKEND ONLY. Never put the secret key in frontend code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
